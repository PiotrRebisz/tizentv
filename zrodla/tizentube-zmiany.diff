 }
 
+// ---- Przycisk "Dzwiek" na pasku odtwarzacza ----
+
+function rendererOf(item) {
+    if (!item || typeof item !== 'object') return null;
+    const key = Object.keys(item).find(k => /Renderer$/.test(k));
+    return key ? item[key] : null;
+}
+
+function textOf(text) {
+    if (!text) return '';
+    if (text.simpleText) return text.simpleText;
+    if (text.runs) return text.runs.map(r => r.text).join('');
+    return '';
+}
+
+function commandOf(renderer) {
+    if (!renderer) return null;
+    return renderer.serviceEndpoint || renderer.command || renderer.navigationEndpoint || renderer.onSelectCommand || null;
+}
+
+const TT_SUBMENUS = {
+    audio: {
+        iconRe: /AUDIO|VOLUME|SPEAKER|SOUND|HEADSET|HEADPHONE/i,
+        titleRe: /d\u017awi\u0119k|dzwiek|audio|sound|\u015bcie\u017ck/i,
+        iconKey: 'ttAudioIconType',
+        titleKey: 'player.audioSettings.title',
+        unavailableKey: 'player.audioSettings.unavailable'
+    },
+    quality: {
+        iconRe: /QUALITY|^HD$|^SETTINGS_HD|HIGH_DEFINITION/i,
+        titleRe: /jako\u015b\u0107|jakosc|quality/i,
+        iconKey: 'ttQualityIconType',
+        titleKey: 'player.qualitySettings.title',
+        unavailableKey: 'player.qualitySettings.unavailable'
+    }
+};
+
+function findSubmenuItem(items, spec) {
+    if (!Array.isArray(items)) return null;
+    for (const item of items) {
+        const r = rendererOf(item);
+        if (!r) continue;
+        const icon = r.icon && r.icon.iconType;
+        const title = textOf(r.title);
+        if ((icon && spec.iconRe.test(icon)) || spec.titleRe.test(title)) {
+            return { cmd: r.isDisabled ? null : commandOf(r), icon: icon || null, title };
+        }
+    }
+    return null;
+}
+
+function describeItems(items) {
+    if (!Array.isArray(items)) return '';
+    return items.map(item => {
+        const r = rendererOf(item);
+        return r ? `${(r.icon && r.icon.iconType) || '?'}:${textOf(r.title)}` : '?';
+    }).join(', ');
+}
+
+function openSubmenu(kind) {
+    const spec = TT_SUBMENUS[kind];
+    const gear = window.__ttPlaybackSettingsButton;
+    const gearCmd = gear ? commandOf(gear.button && gear.button.buttonRenderer ? gear.button.buttonRenderer : rendererOf(gear.button)) : null;
+    if (gearCmd) {
+        window.__ttSubmenuPending = { kind, at: Date.now() };
+        resolveCommand(gearCmd);
+        return;
+    }
+    if (window['__ttCmd_' + kind]) {
+        resolveCommand(window['__ttCmd_' + kind]);
+        return;
+    }
+    const keys = gear && gear.button ? Object.keys(gear.button.buttonRenderer || gear.button).join(',') : 'brak';
+    showToast(t(spec.titleKey), t('player.submenu.openOnce') + ' [' + keys + ']');
+}
+
 function customAction(action, parameters) {
     switch (action) {
+        case 'TT_AUDIO_SETTINGS':
+            openSubmenu('audio');
+            break;
+        case 'TT_QUALITY_SETTINGS':
+            openSubmenu('quality');
+            break;
+        case 'TT_LOCAL_UPDATE_ACK':
+            configWrite('ttUpdateAckSig', parameters);
+            break;
+        case 'TT_LOCAL_UPDATE_LATER':
+            configWrite('ttUpdateRemindAt', parameters);
+            break;
+        case 'TT_LOCAL_UPDATE_CHECK':
+            checkLocalUpdates(true);
+            break;
         case 'SETTINGS_UPDATE':
             modernUI(true, parameters);
             break;
