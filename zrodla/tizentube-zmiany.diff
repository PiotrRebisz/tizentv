diff --git a/mods/features/autoPlayAfterSeek.js b/mods/features/autoPlayAfterSeek.js
new file mode 100644
index 0000000..15efad0
--- /dev/null
+++ b/mods/features/autoPlayAfterSeek.js
@@ -0,0 +1,115 @@
+// Odtwarzanie po przewinieciu (jak w SmartTube): gdy film gral, a uzytkownik przewija go strzalkami
+// lewo/prawo (albo przyciskami przewijania na pilocie), po chwili bez naciskania film sam rusza
+// od nowego miejsca, bez naciskania Play.
+
+import { configRead } from '../config.js';
+
+const SEEK_KEYS = [37, 39, 412, 417]; // lewo, prawo, przewin do tylu, przewin do przodu
+const DELAY_MS = 1000;
+
+let timer = null;
+let wasPlaying = false;
+let startTime = null;
+
+function getPlayer() {
+    return document.querySelector('.html5-video-player');
+}
+
+function isWatchPage() {
+    return window.location.href.indexOf('watch') !== -1;
+}
+
+function isPlaying(player) {
+    try {
+        const state = player.getPlayerStateObject();
+        return !!(state && state.isPlaying);
+    } catch (e) {
+        const video = document.querySelector('video');
+        return !!(video && !video.paused);
+    }
+}
+
+function currentTime(player) {
+    try {
+        if (player.getCurrentTime) return player.getCurrentTime();
+    } catch (e) { }
+    const video = document.querySelector('video');
+    return video ? video.currentTime : null;
+}
+
+function pressEnter() {
+    const target = document.activeElement || document.body;
+    for (const type of ['keydown', 'keyup']) {
+        const evt = new KeyboardEvent(type, { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true });
+        try {
+            if (evt.keyCode !== 13) {
+                Object.defineProperty(evt, 'keyCode', { get: () => 13 });
+                Object.defineProperty(evt, 'which', { get: () => 13 });
+            }
+        } catch (e) { }
+        // Znacznik naszego wlasnego OK (Cobalt nie obsluguje isTrusted, wiec nie mozna na nim polegac).
+        evt.__ttSynthetic = true;
+        target.dispatchEvent(evt);
+    }
+}
+
+export function cancelAutoPlayAfterSeek() {
+    reset();
+}
+
+function reset() {
+    if (timer) clearTimeout(timer);
+    timer = null;
+    wasPlaying = false;
+    startTime = null;
+}
+
+function resumeIfNeeded() {
+    timer = null;
+    const player = getPlayer();
+    const shouldResume = wasPlaying;
+    const before = startTime;
+    wasPlaying = false;
+    startTime = null;
+    if (!shouldResume || !player || !isWatchPage() || isPlaying(player)) return;
+
+    const now = currentTime(player);
+    const moved = before !== null && now !== null && Math.abs(now - before) > 0.5;
+    if (moved) {
+        // Przewiniecie juz sie wykonalo, film tylko stoi: wznawiamy.
+        try {
+            if (player.playVideo) player.playVideo();
+            else document.querySelector('video').play();
+        } catch (e) {
+            pressEnter();
+        }
+    } else {
+        // Przewiniecie czeka na potwierdzenie: potwierdzamy tak, jak zrobilby to przycisk OK.
+        pressEnter();
+    }
+}
+
+function onKeyDown(evt) {
+    if (!configRead('enableAutoPlayAfterSeek')) return;
+    if (evt.__ttSynthetic) return; // nasze wlasne OK
+
+    if (SEEK_KEYS.indexOf(evt.keyCode) === -1) {
+        // Inny klawisz (OK, Wstecz, itp.): uzytkownik sam decyduje, nic nie wznawiamy.
+        if (timer) reset();
+        return;
+    }
+    if (!isWatchPage()) return;
+    const player = getPlayer();
+    if (!player) return;
+
+    if (!timer) {
+        // Poczatek przewijania: zapamietaj, czy film gral i gdzie byl.
+        wasPlaying = isPlaying(player);
+        startTime = currentTime(player);
+    } else {
+        clearTimeout(timer);
+    }
+    timer = setTimeout(resumeIfNeeded, DELAY_MS);
+}
+
+document.addEventListener('keydown', onKeyDown, true);
diff --git a/mods/features/localUpdateNotice.js b/mods/features/localUpdateNotice.js
new file mode 100644
index 0000000..d1c5372
--- /dev/null
+++ b/mods/features/localUpdateNotice.js
@@ -0,0 +1,115 @@
+// Powiadomienie o nowej wersji TizenTube dla wersji zbudowanej lokalnie (z przyciskami na pasku).
+// Ta wersja ma skrypt wbudowany w paczke, wiec nie aktualizuje sie sama. Raz przy starcie
+// sprawdzamy, czy autor TizenTube wydal nowszy skrypt albo nowsza aplikacje, i pokazujemy komunikat.
+
+import { buttonItem, showModal, showToast, overlayPanelItemListRenderer, overlayMessageRenderer } from '../ui/ytUI.js';
+import { configRead } from '../config.js';
+import { t } from 'i18next';
+
+// Na Androidzie (TizenTube Cobalt) jest obiekt h5vcc.tizentube, na Samsungu go nie ma.
+export const IS_ANDROID = !!(window.h5vcc && window.h5vcc.tizentube);
+
+// Wersje, z ktorych zbudowano te paczke.
+export const LOCAL_BASE = {
+    script: '1.15.2',                                         // @foxreis/tizentube (userScript)
+    app: IS_ANDROID ? '2.0.3' : '2.1.1',                      // wersja aplikacji, na ktorej oparto paczke
+    appRepo: IS_ANDROID ? 'reisxd/TizenTubeCobalt' : 'reisxd/TizenTube'
+};
+
+function compareVersions(a, b) {
+    const pa = String(a).replace(/^v/, '').split('.').map(n => parseInt(n, 10) || 0);
+    const pb = String(b).replace(/^v/, '').split('.').map(n => parseInt(n, 10) || 0);
+    for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
+        const d = (pa[i] || 0) - (pb[i] || 0);
+        if (d !== 0) return d;
+    }
+    return 0;
+}
+
+function fetchJson(url) {
+    return fetch(url, { cache: 'no-store' }).then(r => {
+        if (!r.ok) throw new Error('HTTP ' + r.status);
+        return r.json();
+    });
+}
+
+function getLatestScriptVersion() {
+    return fetchJson('https://registry.npmjs.org/@foxreis/tizentube/latest')
+        .then(j => j.version)
+        .catch(() => fetchJson('https://data.jsdelivr.com/v1/packages/npm/@foxreis/tizentube/resolved').then(j => j.version));
+}
+
+function getLatestAppVersion() {
+    return fetchJson('https://api.github.com/repos/' + LOCAL_BASE.appRepo + '/releases/latest')
+        .then(j => String(j.tag_name || '').replace(/^v/, ''));
+}
+
+export function checkLocalUpdates(manual) {
+    return Promise.all([
+        getLatestScriptVersion().catch(() => null),
+        getLatestAppVersion().catch(() => null)
+    ]).then(([script, app]) => {
+        if (!script && !app) {
+            if (manual) showToast(t('localUpdate.checkFailed.title'), t('localUpdate.checkFailed.subtitle'));
+            return;
+        }
+        const lines = [];
+        if (script && compareVersions(script, LOCAL_BASE.script) > 0) {
+            lines.push(t('localUpdate.scriptLine', { from: LOCAL_BASE.script, to: script }));
+        }
+        if (app && compareVersions(app, LOCAL_BASE.app) > 0) {
+            lines.push(t('localUpdate.appLine', { from: LOCAL_BASE.app, to: app }));
+        }
+
+        if (lines.length === 0) {
+            if (manual) showToast(t('localUpdate.upToDate.title'), t('localUpdate.upToDate.subtitle'));
+            return;
+        }
+
+        const signature = `s${script || ''}|a${app || ''}`;
+        if (!manual && configRead('ttUpdateAckSig') === signature) return;
+
+        const now = Math.floor(Date.now() / 1000);
+        const buttons = [
+            buttonItem(
+                { title: t('localUpdate.ok.title'), subtitle: t('localUpdate.ok.subtitle') },
+                { icon: 'CHECK_BOX' },
+                [
+                    { customAction: { action: 'TT_LOCAL_UPDATE_ACK', parameters: signature } },
+                    { signalAction: { signal: 'POPUP_BACK' } }
+                ]
+            ),
+            buttonItem(
+                { title: t('localUpdate.later.title'), subtitle: t('localUpdate.later.subtitle') },
+                { icon: 'SEARCH_HISTORY' },
+                [
+                    { customAction: { action: 'TT_LOCAL_UPDATE_LATER', parameters: now + 86400 } },
+                    { signalAction: { signal: 'POPUP_BACK' } }
+                ]
+            )
+        ];
+        // Pusty komunikat, zeby styl nie rozjezdzal sie po nacisnieciu przycisku (jak w oryginalnym updaterze).
+        buttons.push(overlayMessageRenderer(' '));
+        buttons.push(overlayMessageRenderer(lines.join('\n') + '\n\n' + t(IS_ANDROID ? 'localUpdate.explainAndroid' : 'localUpdate.explain')));
+
+        showModal(
+            {
+                title: t('localUpdate.available.title'),
+                subtitle: t('localUpdate.available.subtitle')
+            },
+            overlayPanelItemListRenderer(buttons),
+            'tt-local-update-modal',
+            false
+        );
+    });
+}
+
+// Automatyczne sprawdzenie raz po starcie (z opoznieniem, zeby nie przeszkadzac w ladowaniu strony).
+setTimeout(() => {
+    try {
+        if (!configRead('enableLocalUpdateNotice')) return;
+        const now = Math.floor(Date.now() / 1000);
+        if ((configRead('ttUpdateRemindAt') || 0) > now) return;
+        checkLocalUpdates(false).catch(() => { });
+    } catch (e) { }
+}, 15000);
diff --git a/mods/features/pauseOnFirstOk.js b/mods/features/pauseOnFirstOk.js
new file mode 100644
index 0000000..37ffb6e
--- /dev/null
+++ b/mods/features/pauseOnFirstOk.js
@@ -0,0 +1,116 @@
+// Pauza jednym OK (jak w SmartTube): gdy film gra, a pasek odtwarzacza jest schowany, pierwsze
+// nacisniecie OK od razu zatrzymuje film (zamiast tylko pokazywac pasek).
+// Gdy pasek jest widoczny, OK dziala normalnie (na przycisk, ktory ma fokus).
+
+import { configRead } from '../config.js';
+import { showToast } from '../ui/ytUI.js';
+import { cancelAutoPlayAfterSeek } from './autoPlayAfterSeek.js';
+
+let swallowUntil = 0;
+let keySeq = 0; // licznik nacisniec, zeby zapasowa pauza nie zadzialala po kolejnym klawiszu
+
+function getPlayer() {
+    return document.querySelector('.html5-video-player');
+}
+
+function isWatchPage() {
+    return window.location.href.indexOf('watch') !== -1;
+}
+
+function isPlaying(player) {
+    try {
+        const state = player.getPlayerStateObject();
+        return !!(state && state.isPlaying);
+    } catch (e) {
+        const video = document.querySelector('video');
+        return !!(video && !video.paused);
+    }
+}
+
+// Stan paska: ytlr-watch-default ma hybridnavfocusable="true", gdy pasek jest schowany
+// (z tego korzysta zegar TizenTube), a ytlr-progress-bar ma "false" (z tego korzysta SponsorBlock).
+function overlayState() {
+    const watch = document.querySelector('ytlr-watch-default');
+    const bar = document.querySelector('ytlr-progress-bar');
+    const active = document.activeElement;
+    return {
+        watch: watch ? watch.getAttribute('hybridnavfocusable') : 'brak',
+        bar: bar ? bar.getAttribute('hybridnavfocusable') : 'brak',
+        // Fokus na samym ytlr-watch-default (a nie na przycisku paska) tez oznacza schowany pasek.
+        focusOnWatch: !!(watch && active && active === watch)
+    };
+}
+
+export function controlsHidden(state) {
+    const s = state || overlayState();
+    if (s.focusOnWatch) return true;
+    if (s.watch === 'brak' && s.bar === 'brak') return false;
+    const watchHidden = s.watch === 'brak' || s.watch === 'true';
+    const barHidden = s.bar === 'brak' || s.bar === 'false';
+    return watchHidden && barHidden;
+}
+
+function pause(player) {
+    try {
+        if (player.pauseVideo) player.pauseVideo();
+        else document.querySelector('video').pause();
+    } catch (e) {
+        try { document.querySelector('video').pause(); } catch (e2) { }
+    }
+    // Zapas: gdyby odtwarzacz nie zareagowal, zatrzymaj sam element video
+    // (tylko jesli w miedzyczasie nie nacisnieto zadnego klawisza).
+    const seq = keySeq;
+    setTimeout(() => {
+        if (seq !== keySeq || !isPlaying(player)) return;
+        const video = document.querySelector('video');
+        try { if (video) video.pause(); } catch (e) { }
+        setTimeout(() => {
+            if (seq === keySeq && isPlaying(player)) showToast('Pauza jednym OK', 'Nie udało się zatrzymać filmu.');
+        }, 300);
+    }, 300);
+}
+
+function swallow(evt) {
+    evt.preventDefault();
+    evt.stopPropagation();
+    if (evt.stopImmediatePropagation) evt.stopImmediatePropagation();
+}
+
+function onKey(evt) {
+    // Nasze wlasne OK (z autoPlayAfterSeek) ma znacznik; isTrusted w Cobalt nie dziala.
+    if (evt.__ttSynthetic) return;
+    if (evt.type === 'keydown') keySeq++;
+    if (evt.keyCode !== 13) return;
+
+    if (evt.type !== 'keydown') {
+        // keyup/keypress tego samego nacisniecia tez nie moze dojsc do YouTube.
+        if (Date.now() < swallowUntil) {
+            if (evt.type === 'keyup') swallowUntil = 0;
+            swallow(evt);
+        }
+        return;
+    }
+
+    if (!configRead('enablePauseOnFirstOk')) return;
+    // Przy wylaczonym ekranie OK ma go wlaczyc (obsluga w ui/ui.js), wiec go nie przechwytujemy.
+    if (window.screenTurnedOffAt) return;
+    if (!isWatchPage()) return;
+    const player = getPlayer();
+    const playing = !!player && isPlaying(player);
+    const before = overlayState();
+    const hidden = controlsHidden(before);
+    if (!playing) return;
+
+    if (hidden) {
+        swallow(evt);
+        swallowUntil = Date.now() + 1500;
+        cancelAutoPlayAfterSeek();
+        pause(player);
+        return;
+    }
+}
+
+// window + faza przechwytywania: dostajemy klawisz, zanim trafi do YouTube.
+window.addEventListener('keydown', onKey, true);
+window.addEventListener('keypress', onKey, true);
+window.addEventListener('keyup', onKey, true);
